{
  "subjectContract": 1,
  "description": "Canonicalisation vectors of the ledger subject contract, version 1 (spec section 8). The server canonicalises the subject value; a client never does. Data for implementers: no suite case reads this file.",
  "rules": [
    "the value is a string, or a safe integer in its decimal string form; any other type is VALIDATION",
    "a lone surrogate is VALIDATION",
    "trim Unicode White_Space at both ends",
    "normalise to NFC",
    "with subjectCase fold: toLowerCase, then NFC again",
    "empty, U+0000-U+001F, U+007F-U+009F, or over LIMITS.ledgerSubjectMaxBytes UTF-8 bytes is VALIDATION"
  ],
  "vectors": [
